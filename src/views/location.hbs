{{! Include menu partial}}
{{> menu}}

<section class="section columns is-vcentered">
  <div class="column">
    <div class="title">
      {{location.title}}
    </div>
    <div class="is-flex" style="gap: 50px;">
      <div class="is-flex">
        <p>Latitude: </p>
        {{location.latitude}}
      </div>
      <div class="is-flex">
        <p>Longitude: </p>
        {{location.longitude}}
      </div>
    </div>

    {{> list-runs}}
    {{> add-run}}
  </div>
  <div class="column">
    {{> location-image }}
  </div>
</section>

